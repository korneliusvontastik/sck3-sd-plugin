{
    "name": "sck3-streamdeck-plugin",
    "version": "0.1.0",
    "description": "Star Citizen plugin for Elgato Stream Deck devices, part of SCK3 (Star Citizen Kommand Kontrol Kit) by KVT Korp. Unofficial fan project, not affiliated with Cloud Imperium Games.",
    "author": "Kornelius Von Tastik",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/korneliusvontastik/sck3-sd-plugin.git"
    },
    "homepage": "https://github.com/korneliusvontastik/sck3-sd-plugin",
    "bugs": {
        "url": "https://github.com/korneliusvontastik/sck3-sd-plugin/issues"
    },
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.kvt.sck3\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean:logs": "node -e \"require('fs').rmSync('com.kvt.sck3.sdPlugin/logs', { recursive: true, force: true })\"",
        "pack": "npm run build && npm run clean:logs && streamdeck pack com.kvt.sck3.sdPlugin --force"
    },
    "type": "module",
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0",
        "fast-xml-parser": "^4.5.3",
        "opentype.js": "^2.0.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "@types/opentype.js": "^1.3.10",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2",
        "vitest": "^3.2.4"
    }
}
